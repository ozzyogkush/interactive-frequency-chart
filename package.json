{
  "name": "interactive-frequency-chart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "yarn run eslint ./",
    "lint:fix": "yarn run eslint ./ --fix",
    "lint:diff": "FILES=$(git diff HEAD --name-only --relative ./ | grep -E '\\.[j|mj|cj|t]sx?$' | xargs ls -d 2>/dev/null); echo $FILES; yarn run eslint $FILES",
    "preview": "vite preview",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "dependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "husky": "9.1.7",
    "prettier": "3.4.2",
    "pretty-quick": "4.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.17.0",
    "vite": "6.4.1"
  },
  "packageManager": "yarn@4.5.3"
}
